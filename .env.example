# LLM API Key (Groq)
GROQ_API_KEY=your_groq_api_key_here

# MySQL Database Configuration (Matches app/db/database.py and seed.py)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=enterprise_ops_db

# Streamlit UI to FastAPI Backend URL
API_BASE_URL=http://127.0.0.1:8000

# Optional: LangSmith Observability & Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Autonomous-Enterprise-Ops-Engine